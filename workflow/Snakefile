import yaml

from snakemake.utils import min_version, validate

min_version("9.19")


pathvars:
    logs="logs",
    resources="resources",
    results="results",
    shapes="resources/user/{shapes}/shapes.parquet",
    temperature_grid="<resources>/automatic/grids_depth/temperature{depth}.asc",
    sediment_thickness="<resources>/automatic/Global_sedmap_1deg.nc",
    efficiency_curves="<resources>/automatic/efficiency_curves.csv",
    baseline_drilling_2017="<resources>/automatic/baseline_drilling_2017.csv",
    baseline_drilling_2025="<resources>/automatic/baseline_drilling_2025.csv",
    scenario_table="<resources>/automatic/scenario_table.tsv",
    temp_voxel="<results>/{shapes}/temp_voxel.nc",
    clipped_temp_voxel="<results>/{shapes}/clipped_temp_voxel.nc",
    lcoe_cube="<results>/{shapes}/scenarios/{scenario}/geothermal_lcoe/{cycle}_lcoe_cube.nc",
    lcoe_2d="<results>/{shapes}/scenarios/{scenario}/2d_potential_cost/{cycle}_2d_lcoe.tif",
    potential_2d="<results>/{shapes}/scenarios/{scenario}/2d_potential_cost/{cycle}_2d_potential.tif",
    lcoe_2d_depth_category="<results>/{shapes}/scenarios/{scenario}/2d_potential_cost/{cycle}_2d_{cat}_lcoe.tif",
    potential_2d_depth_category="<results>/{shapes}/scenarios/{scenario}/2d_potential_cost/{cycle}_2d_{cat}_potential.tif",
    geothermal_regions="<results>/{shapes}/scenarios/{scenario}/region_aggregation/geothermal_regions.parquet",


# Load the example configuration. This will be overridden by users.
configfile: workflow.source_path("../config/config.yaml")


# Validate the configuration using the schema file.
validate(config, workflow.source_path("internal/config.schema.yaml"))

# Load internal settings separately so users cannot modify them.
with open(workflow.source_path("internal/settings.yaml"), "r") as f:
    internal = yaml.safe_load(f)


# Add all your includes here.
include: "rules/common.smk"
include: "rules/automatic.smk"
include: "rules/dummy.smk"


# Add additional files to be delivered alongside the workflow here.
# This is needed e.g. for python code files that are never
# explicitly used as a script or input in a snakemake rule.
workflow.source_path("scripts/scenario_config.py")


rule all:
    message:
        "ERROR: Invalid `rule all:` call"
    default_target: True
    output:
        "INVALID",
    log:
        stderr="<logs>/all.stderr",
    conda:
        "envs/shell.yaml"
    shell:
        'echo "This workflow must be called as a snakemake module." > {log.stderr}'


ruleorder: make_2d_base > make_2d_scenario
