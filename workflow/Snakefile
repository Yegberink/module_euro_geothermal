import os
import sys

import yaml

from snakemake.utils import min_version, validate

min_version("9.19")

sys.path.insert(0, os.path.dirname(workflow.source_path("scripts/scenario_config.py")))
from scenario_config import validate_module_config


def deep_update(base, overrides):
    for key, value in (overrides or {}).items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            deep_update(base[key], value)
        else:
            base[key] = value
    return base


pathvars:
    shapes="<resources>/user/{shapes}/shapes.parquet",
    geothermal_regions="<results>/{shapes}/{scenario}/geothermal_regions.parquet",
    overall_potential_by_scenario="<results>/{shapes}/overall_potential_by_scenario.tsv",
    overall_potential_summary="<results>/{shapes}/overall_potential_summary.tsv",


wildcard_constraints:
    shapes="[A-Za-z0-9][A-Za-z0-9_-]*",
    scenario="[A-Za-z0-9][A-Za-z0-9_.-]*",
    cycle="orc|flash|kalina",


# Load the example configuration. This will be overridden by users.
configfile: workflow.source_path("../config/config.yaml")


# Fill stable module defaults before validation. This lets external workflows
# provide only the settings that matter for their requested target.
with open(workflow.source_path("internal/settings.yaml"), "r") as f:
    internal = yaml.safe_load(f) or {}

default_config = internal.get("defaults", {})
merged_config = deep_update(default_config, config)
config.clear()
config.update(merged_config)


# Validate the configuration using the schema file.
validate(config, workflow.source_path("internal/config.schema.yaml"))
validate_module_config(config)


# Add all your includes here.
include: "rules/automatic.smk"
include: "rules/lcoe.smk"
include: "rules/spatial_aggregation.smk"
include: "rules/scenario_figures.smk"
include: "rules/sensitivity.smk"


# Add additional files to be delivered alongside the workflow here.
# This is needed e.g. for python code files that are never
# explicitly used as a script or input in a snakemake rule.
workflow.source_path("scripts/scenario_config.py")
workflow.source_path("scripts/_schemas.py")


rule all:
    message:
        "ERROR: Invalid `rule all:` call"
    default_target: True
    output:
        "INVALID",
    log:
        stderr="<logs>/all.stderr",
    conda:
        "envs/shell.yaml"
    shell:
        'echo "This workflow must be called as a snakemake module." > {log.stderr}'


ruleorder: make_2d_base > make_2d_scenario
