import yaml

module_config = {}
with open(workflow.source_path("../../config/config.yaml"), "r") as f:
    module_config["module_geothermal"] = yaml.safe_load(f.read())


module module_geothermal:
    snakefile:
        "../../workflow/Snakefile"
    config:
        module_config["module_geothermal"]
    pathvars:
        logs="results/integration_test/logs",
        resources="../../resources",
        results="results/integration_test/results",
        shapes="../../resources/user/{shapes}/shapes.parquet",


use rule * from module_geothermal as module_geothermal_*


rule all:
    message:
        "A generic test case for the geothermal module."
    default_target: True
    input:
        "results/integration_test/results/euro_all/base/geothermal_regions.parquet",
